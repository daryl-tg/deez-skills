#!/usr/bin/env bash
# Resolve a tomllib-capable Python (3.11+) and run the deez CLI.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

find_python() {
  local candidate
  for candidate in "${DEEZ_PYTHON:-}" python3 python3.14 python3.13 python3.12 python3.11; do
    [ -n "$candidate" ] || continue
    command -v "$candidate" >/dev/null 2>&1 || continue
    if "$candidate" -c 'import tomllib' >/dev/null 2>&1; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  return 1
}

if ! PY="$(find_python)"; then
  cat >&2 <<'MSG'
deez: no Python with tomllib (3.11+) found.
Tried: $DEEZ_PYTHON, python3, python3.14, python3.13, python3.12, python3.11
Fix:   brew install python@3.14
       or set DEEZ_PYTHON=/path/to/python3.11-or-newer
MSG
  exit 3
fi

exec "$PY" -c '
import sys
sys.path.insert(0, sys.argv[1])
from deezlib.cli import main
sys.exit(main(sys.argv[2:]))
' "$REPO" "$@"
