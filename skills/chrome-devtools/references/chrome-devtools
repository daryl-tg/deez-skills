def format_interactive(elements: list[dict[str, Any]]) -> str:
    if not elements:
        return "No visible interactive elements found."
    lines = []
    for element in elements:
        label = (
            element.get("label")
            or element.get("text")
            or element.get("placeholder")
            or element.get("href")
            or ""
        )
        element_type = element.get("type")
        type_part = f" type={element_type}" if element_type else ""
        tag_part = f"<{element.get('tag', '')}{type_part}>"
        parts = [f"[ref={element.get('ref', '')}]", tag_part]
        if element.get("role"):
            parts.append(f"role={element['role']}")
        if label:
            parts.append(f'"{short(label, 100)}"')
        if element.get("href"):
            parts.append(f"href={short(element['href'], 80)}")
        if element.get("selector"):
            parts.append(f"selector={element['selector']}")
        lines.append(" ".join(parts))
    return "\n".join(lines)


def format_snapshot(snapshot: dict[str, Any], mode: str, selector: str) -> str:
    if mode == "text":
        return str(snapshot.get("text") or "No visible text found.")
    if mode == "html":
        return str(snapshot.get("html") or "No HTML found.")
    if mode == "interactive":
        return format_interactive(dict_list_value(snapshot.get("interactive")))
    parts = [
        f"URL: {snapshot.get('url', '')}",
        f"Title: {snapshot.get('title') or '(untitled)'}",
    ]
    if selector:
        parts.append(f"Selector: {selector}")
    parts.extend(
        [
            "",
            "## Visible text",
            str(snapshot.get("text") or "No visible text found."),
            "",
            "## Interactive elements",
            format_interactive(dict_list_value(snapshot.get("interactive"))),
        ]
    )
    return "\n".join(parts)


def ax_value(raw: Any) -> str | None:
    if not isinstance(raw, dict):
        return None
    value = raw.get("value")
    if isinstance(value, (str, int, float, bool)):
        return str(value)
    return None


def read_accessibility(client: CdpClient) -> str:
    raw = client.call("Accessibility.getFullAXTree", {})
    nodes = raw.get("nodes") if isinstance(raw, dict) else None
    if not isinstance(nodes, list):
        return "Accessibility tree was empty."
    lines = []
    for node in nodes:
        if not isinstance(node, dict):
            continue
        role = ax_value(node.get("role"))
        name = ax_value(node.get("name"))
        value = ax_value(node.get("value"))
        if not role and not name and not value:
            continue
        parts = []
        if role:
            parts.append(f"<{role}>")
        if name:
            parts.append(f'"{short(name, 120)}"')
        if value:
            parts.append(f'value="{short(value, 80)}"')
        if parts:
            lines.append(" ".join(parts))
        if len(lines) >= 500:
            break
    return "\n".join(lines) if lines else "Accessibility tree contained no named nodes."


def format_log_argument(remote: Any) -> str:
    if not isinstance(remote, dict):
        return str(remote)
    if "value" in remote:
        value = remote.get("value")
        if isinstance(value, str):
            return value
        return compact_json(value)
    if remote.get("unserializableValue"):
        return str(remote["unserializableValue"])
    if remote.get("description"):
        return str(remote["description"])
    return str(remote.get("type") or "")


def first_call_frame(stack_trace: Any) -> dict[str, Any]:
    current = stack_trace if isinstance(stack_trace, dict) else None
    while current:
        call_frames = current.get("callFrames")
        if isinstance(call_frames, list) and call_frames:
            frame = call_frames[0]
            if isinstance(frame, dict):
                return frame
        current = (
            current.get("parent") if isinstance(current.get("parent"), dict) else None
        )
    return {}


def add_frame_location(entry: dict[str, Any], frame: Any) -> dict[str, Any]:
    if not isinstance(frame, dict):
        return entry
    if frame.get("url"):
        entry["url"] = frame.get("url")
    if isinstance(frame.get("lineNumber"), int):
        entry["lineNumber"] = frame["lineNumber"] + 1
    if isinstance(frame.get("columnNumber"), int):
        entry["columnNumber"] = frame["columnNumber"] + 1
    return entry


def log_entry_from_event(event: dict[str, Any]) -> dict[str, Any] | None:
    method = event.get("method")
    params = dict_value(event.get("params"))
    if method == "Runtime.consoleAPICalled":
        args = list_value(params.get("args"))
        text = (
            normalize_text(" ".join(format_log_argument(arg) for arg in args))
            or params.get("type")
            or "console"
        )
        entry = {
            "kind": "console",
            "source": "console",
            "level": params.get("type") or "log",
            "text": text,
            "timestamp": params.get("timestamp"),
        }
        return add_frame_location(entry, first_call_frame(params.get("stackTrace")))
    if method == "Log.entryAdded":
        raw = dict_value(params.get("entry"))
        entry = {
            "kind": "log",
            "source": raw.get("source") or "log",
            "level": raw.get("level") or "info",
            "text": normalize_text(raw.get("text") or ""),
            "timestamp": raw.get("timestamp"),
        }
        if raw.get("url"):
            entry["url"] = raw.get("url")
        if isinstance(raw.get("lineNumber"), int):
            entry["lineNumber"] = raw["lineNumber"] + 1
        if raw.get("networkRequestId"):
            entry["networkRequestId"] = raw.get("networkRequestId")
        return entry
    if method == "Runtime.exceptionThrown":
        details = dict_value(params.get("exceptionDetails"))
        entry = {
            "kind": "exception",
            "source": "runtime",
            "level": "error",
            "text": normalize_text(format_runtime_exception(details)),
            "timestamp": params.get("timestamp"),
        }
        if details.get("url"):
            entry["url"] = details.get("url")
        if isinstance(details.get("lineNumber"), int):
            entry["lineNumber"] = details["lineNumber"] + 1
        if isinstance(details.get("columnNumber"), int):
            entry["columnNumber"] = details["columnNumber"] + 1
        return entry
    return None


def update_network_request(
    requests: dict[str, dict[str, Any]] | None, event: dict[str, Any]
) -> None:
    if requests is None:
        return
    params = dict_value(event.get("params"))
    request_id = params.get("requestId")
    if not request_id:
        return
    request = requests.get(str(request_id))
    if request is None:
        if len(requests) >= DEFAULT_NETWORK_REQUEST_LIMIT:
            return
        request = {"requestId": request_id}
        requests[str(request_id)] = request
    method = event.get("method")
    if method == "Network.requestWillBeSent":
        raw_request = dict_value(params.get("request"))
        initiator = dict_value(params.get("initiator"))
        request.update(
            {
                "url": raw_request.get("url") or request.get("url") or "",
                "method": raw_request.get("method") or request.get("method") or "",
                "type": params.get("type") or request.get("type") or "",
                "initiatorType": initiator.get("type")
                or request.get("initiatorType")
                or "",
                "timestamp": params.get("timestamp"),
                "wallTime": params.get("wallTime"),
            }
        )
    elif method == "Network.responseReceived":
        response = dict_value(params.get("response"))
        request.update(
            {
                "url": response.get("url") or request.get("url") or "",
                "type": params.get("type") or request.get("type") or "",
                "status": response.get("status"),
                "statusText": response.get("statusText") or "",
                "mimeType": response.get("mimeType") or "",
                "protocol": response.get("protocol") or "",
                "fromDiskCache": bool(response.get("fromDiskCache", False)),
            }
        )
    elif method == "Network.loadingFinished":
        request.update(
            {"finished": True, "encodedDataLength": params.get("encodedDataLength", 0)}
        )
    elif method == "Network.loadingFailed":
        request.update(
            {
                "failed": True,
                "errorText": params.get("errorText") or "",
                "canceled": bool(params.get("canceled", False)),
                "blockedReason": params.get("blockedReason") or "",
            }
        )


def collect_log_event(
    event: dict[str, Any],
    entries: list[dict[str, Any]],
    requests: dict[str, dict[str, Any]] | None,
) -> None:
    method = event.get("method")
    entry = log_entry_from_event(event)
    if entry is not None and len(entries) < DEFAULT_LOG_ENTRY_LIMIT:
        entries.append(entry)
    if isinstance(method, str) and method.startswith("Network."):
        update_network_request(requests, event)


def format_bytes(value: Any) -> str:
    if value is None or value == "":
        return ""
    try:
        size = float(value)
    except (TypeError, ValueError):
        return ""
    units = ["B", "KiB", "MiB", "GiB"]
    unit = units[0]
    for unit in units:
        if size < 1024 or unit == units[-1]:
            break
        size /= 1024
    if unit == "B":
        return f"{int(size)} {unit}"
    return f"{size:.1f} {unit}"


def format_ms(value: Any) -> str:
    try:
        duration = float(value)
    except (TypeError, ValueError):
        return "0ms"
    return f"{duration:.1f}ms"


def format_entry_location(entry: dict[str, Any]) -> str:
    location = str(entry.get("url") or "")
    line_number = entry.get("lineNumber")
    column_number = entry.get("columnNumber")
    if line_number and location:
        location += f":{line_number}"
        if column_number:
            location += f":{column_number}"
    elif line_number:
        location = f"line {line_number}"
    return location


def format_log_entries(entries: list[dict[str, Any]]) -> list[str]:
    if not entries:
        return [
            "No console/log entries captured. CDP streams entries after this command attaches."
        ]
    lines = []
    for entry in entries:
        label = ".".join(
            str(part) for part in [entry.get("source"), entry.get("level")] if part
        )
        line = f"[{label or 'log'}] {entry.get('text') or '(empty log entry)'}"
        location = format_entry_location(entry)
        if location:
            line += f" ({location})"
        lines.append(line)
    return lines


def format_network_request(request: dict[str, Any]) -> str:
    method = request.get("method") or "REQUEST"
    url = request.get("url") or "(unknown URL)"
    if request.get("failed"):
        status = "failed"
        if request.get("errorText"):
            status += f" {request['errorText']}"
    elif request.get("status") is not None:
        status = str(request.get("status"))
    elif request.get("finished"):
        status = "finished"
    else:
        status = "pending"
    extras = []
    if request.get("type"):
        extras.append(str(request["type"]).lower())
    if request.get("mimeType"):
        extras.append(str(request["mimeType"]))
    size = format_bytes(request.get("encodedDataLength"))
    if size:
        extras.append(size)
    suffix = f" ({', '.join(extras)})" if extras else ""
    return f"{method} {status} {short(url, 140)}{suffix}"


def format_network_snapshot(network: dict[str, Any]) -> list[str]:
    lines = ["Captured requests:"]
    requests = dict_list_value(network.get("requests"))
    if requests:
        lines.extend(f"  {format_network_request(request)}" for request in requests)
    else:
        lines.append("  No network requests observed during the capture window.")

    performance = dict_value(network.get("performance"))
    navigation = dict_value(performance.get("navigation"))
    resources = dict_list_value(performance.get("resources"))
    if navigation:
        parts = [format_ms(navigation.get("duration"))]
        transfer_size = format_bytes(navigation.get("transferSize"))
        if transfer_size:
            parts.append(transfer_size)
        if navigation.get("nextHopProtocol"):
            parts.append(str(navigation["nextHopProtocol"]))
        lines.extend(
            [
                "",
                "Navigation timing:",
                f"  {' '.join(parts)} {short(navigation.get('name') or '', 140)}",
            ]
        )
    lines.extend(["", "Resource timings:"])
    if resources:
        for resource in resources:
            kind = (
                resource.get("initiatorType") or resource.get("entryType") or "resource"
            )
            parts = [str(kind), format_ms(resource.get("duration"))]
            transfer_size = format_bytes(resource.get("transferSize"))
            if transfer_size:
                parts.append(transfer_size)
            if resource.get("nextHopProtocol"):
                parts.append(str(resource["nextHopProtocol"]))
            lines.append(
                f"  {' '.join(parts)} {short(resource.get('name') or '', 140)}"
            )
    else:
        lines.append("  No PerformanceResourceTiming entries found.")
    return lines


def format_logs_report(result: dict[str, Any]) -> str:
    lines = [
        f"URL: {result.get('url', '')}",
        f"Title: {result.get('title') or '(untitled)'}",
        f"Capture: {result.get('durationMs', 0)}ms",
        "",
        "## Log entries",
    ]
    lines.extend(format_log_entries(dict_list_value(result.get("entries"))))
    network = result.get("network")
    if isinstance(network, dict):
        lines.extend(["", "## Network"])
        lines.extend(format_network_snapshot(network))
    return "\n".join(lines)


def action_navigate(
    client: CdpClient, params: dict[str, Any], timeout_ms: int
) -> dict[str, Any]:
    url = str(params["url"])
    wait_until = str(params.get("waitUntil", "load"))
    timeout_s = max(timeout_ms / 1000.0, 0.001)
    in_flight = 0
    idle_since = time.monotonic()

    def track_network(event: dict[str, Any]) -> None:
        nonlocal in_flight, idle_since
        method = event.get("method")
        if method == "Network.requestWillBeSent":
            in_flight += 1
        elif method in {"Network.loadingFinished", "Network.loadingFailed"}:
            in_flight = max(0, in_flight - 1)
            if in_flight == 0:
                idle_since = time.monotonic()

    client.call("Page.enable", {})
    if wait_until == "networkIdle":
        client.call("Network.enable", {})
    client.call("Page.navigate", {"url": url})
    if wait_until == "domcontentloaded":
        client.wait_for_event("Page.domContentEventFired", timeout_s, None)
    elif wait_until in {"load", "networkIdle"}:
        client.wait_for_event(
            "Page.loadEventFired",
            timeout_s,
            track_network if wait_until == "networkIdle" else None,
        )
    if wait_until == "networkIdle":
        deadline = time.monotonic() + timeout_s
        while time.monotonic() < deadline:
            while client.events:
                track_network(client.events.pop(0))
            if (
                in_flight == 0
                and (time.monotonic() - idle_since) * 1000 >= DEFAULT_NETWORK_IDLE_MS
            ):
                break
            try:
                message = client._recv_message(
                    min(0.1, max(deadline - time.monotonic(), 0.001))
                )
                if "method" in message:
                    track_network(message)
            except TimeoutError:
                pass
        else:
            raise CdpError(f"Timed out waiting for network idle after {timeout_ms}ms.")
    return {"ok": True}


