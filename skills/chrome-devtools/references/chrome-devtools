def action_logs(
    client: CdpClient, params: dict[str, Any], timeout_ms: int
) -> dict[str, Any]:
    del timeout_ms
    duration_ms = int(params.get("durationMs", 1000))
    include_network = bool(params.get("includeNetwork", False))
    timeout_s = max(duration_ms / 1000.0, 0.0)
    entries: list[dict[str, Any]] = []
    requests: dict[str, dict[str, Any]] | None = {} if include_network else None

    client.call("Runtime.enable", {})
    client.call("Log.enable", {})
    if include_network:
        client.call("Network.enable", {})

    def drain_events() -> None:
        while client.events:
            collect_log_event(client.events.pop(0), entries, requests)

    drain_events()
    deadline = time.monotonic() + timeout_s
    while time.monotonic() < deadline:
        drain_events()
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        try:
            message = client._recv_message(min(0.1, max(remaining, 0.001)))
        except TimeoutError:
            continue
        if "method" in message:
            collect_log_event(message, entries, requests)
    drain_events()

    page_info = evaluate_value(client, page_info_expression())
    if not isinstance(page_info, dict):
        page_info = {}
    result: dict[str, Any] = {
        "url": page_info.get("url") or "",
        "title": page_info.get("title") or "",
        "durationMs": duration_ms,
        "entries": entries,
    }
    if include_network:
        performance = evaluate_value(client, network_snapshot_expression())
        if not isinstance(performance, dict):
            performance = {}
        result["network"] = {
            "requests": list((requests or {}).values()),
            "performance": performance,
        }
    result["text"] = format_logs_report(result)
    return result


