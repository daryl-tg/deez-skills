def page_snapshot_expression(selector: str) -> str:
    return r"""(() => {
        const scopeSelector = %s;
        const normalize = (value) => String(value || "").replace(/\s+/g, " ").trim();
        const normalizeText = (value) => String(value || "")
            .replace(/\r\n?/g, "\n")
            .split("\n")
            .map((line) => line.replace(/[\t ]+/g, " ").trim())
            .filter(Boolean)
            .join("\n")
            .replace(/\n{3,}/g, "\n\n")
            .trim();
        const escapeCss = (value) => globalThis.CSS && CSS.escape ? CSS.escape(String(value)) : String(value).replace(/["\\]/g, "\\$&");
        const visible = (element) => {
            if (!element || !(element instanceof Element)) return false;
            const style = globalThis.getComputedStyle(element);
            const rect = element.getBoundingClientRect();
            return style.display !== "none" && style.visibility !== "hidden" && style.opacity !== "0" && rect.width > 0 && rect.height > 0;
        };
        const selectorFor = (element) => {
            const tag = element.tagName.toLowerCase();
            if (element.id) return tag + "#" + escapeCss(element.id);
            for (const attr of ["name", "type", "aria-label", "placeholder"]) {
                const value = element.getAttribute(attr);
                if (value) return tag + "[" + attr + "=\"" + String(value).replace(/["\\]/g, "\\$&") + "\"]";
            }
            const parent = element.parentElement;
            if (!parent) return tag;
            const siblings = Array.from(parent.children).filter((child) => child.tagName === element.tagName);
            const index = siblings.indexOf(element) + 1;
            return tag + ":nth-of-type(" + index + ")";
        };
        const describe = (element, index) => {
            const ref = "r" + index;
            element.setAttribute("data-pi-ref", ref);
            const tag = element.tagName.toLowerCase();
            const role = element.getAttribute("role") || undefined;
            const type = element.getAttribute("type") || undefined;
            const label = normalize(element.getAttribute("aria-label") || element.getAttribute("title") || element.getAttribute("alt"));
            const text = normalize(element.innerText || element.textContent || "");
            const placeholder = normalize(element.getAttribute("placeholder"));
            const href = element instanceof HTMLAnchorElement ? element.href : undefined;
            return { ref, tag, role, type, label, text, href, placeholder, selector: selectorFor(element) };
        };
        const root = scopeSelector ? document.querySelector(scopeSelector) : document.body;
        if (!root) return { url: location.href, title: document.title, text: "", html: "", interactive: [] };
        const interactiveSelector = [
            "a[href]", "button", "input", "textarea", "select", "summary", "label",
            "[contenteditable=true]", "[role=button]", "[role=link]", "[role=textbox]",
            "[role=checkbox]", "[role=radio]", "[role=switch]", "[role=menuitem]",
        ].join(",");
        const elements = Array.from(root.querySelectorAll(interactiveSelector)).filter(visible).slice(0, 120).map(describe);
        return {
            url: location.href,
            title: document.title,
            text: normalizeText(root.innerText || root.textContent || ""),
            html: scopeSelector && root instanceof Element ? root.outerHTML : document.documentElement.outerHTML,
            interactive: elements,
        };
    })()""" % json.dumps(selector)


def element_point_expression(selector: str, ref: str) -> str:
    return r"""(() => {
        const selector = %s;
        const ref = %s;
        const normalize = (value) => String(value || "").replace(/\s+/g, " ").trim();
        const escapeCss = (value) => globalThis.CSS && CSS.escape ? CSS.escape(String(value)) : String(value).replace(/["\\]/g, "\\$&");
        const element = selector ? document.querySelector(selector) : ref ? document.querySelector('[data-pi-ref="' + escapeCss(ref) + '"]') : null;
        if (!element) return { ok: false, error: "No element matched " + (selector ? "selector " + selector : "ref " + ref) };
        element.scrollIntoView({ block: "center", inline: "center", behavior: "auto" });
        const rect = element.getBoundingClientRect();
        const style = globalThis.getComputedStyle(element);
        if (style.display === "none" || style.visibility === "hidden" || style.opacity === "0" || rect.width <= 0 || rect.height <= 0) {
            return { ok: false, error: "Matched element is not visible." };
        }
        const x = Math.max(0, Math.min(globalThis.innerWidth - 1, rect.left + rect.width / 2));
        const y = Math.max(0, Math.min(globalThis.innerHeight - 1, rect.top + rect.height / 2));
        return { ok: true, x, y, description: element.tagName.toLowerCase() + " " + normalize(element.innerText || element.getAttribute("aria-label") || element.getAttribute("title") || element.getAttribute("placeholder")) };
    })()""" % (json.dumps(selector), json.dumps(ref))


def focus_element_expression(selector: str, ref: str, clear: bool) -> str:
    return r"""(() => {
        const selector = %s;
        const ref = %s;
        const clear = %s;
        const normalize = (value) => String(value || "").replace(/\s+/g, " ").trim();
        const escapeCss = (value) => globalThis.CSS && CSS.escape ? CSS.escape(String(value)) : String(value).replace(/["\\]/g, "\\$&");
        const element = selector ? document.querySelector(selector) : ref ? document.querySelector('[data-pi-ref="' + escapeCss(ref) + '"]') : document.activeElement;
        if (!element) return { ok: false, error: "No focus target found." };
        element.scrollIntoView?.({ block: "center", inline: "center", behavior: "auto" });
        if (typeof element.focus === "function") element.focus();
        if (clear) {
            if ("value" in element) {
                element.value = "";
                element.dispatchEvent(new Event("input", { bubbles: true }));
            } else if (element.isContentEditable) {
                element.textContent = "";
                element.dispatchEvent(new Event("input", { bubbles: true }));
            } else {
                return { ok: false, error: "Target cannot be cleared because it has no value and is not contenteditable." };
            }
        }
        return { ok: true, description: element.tagName.toLowerCase() + " " + normalize(element.getAttribute?.("aria-label") || element.getAttribute?.("placeholder") || element.textContent) };
    })()""" % (json.dumps(selector), json.dumps(ref), json.dumps(bool(clear)))


def submit_expression(selector: str, ref: str) -> str:
    return r"""(() => {
        const selector = %s;
        const ref = %s;
        const escapeCss = (value) => globalThis.CSS && CSS.escape ? CSS.escape(String(value)) : String(value).replace(/["\\]/g, "\\$&");
        const target = selector ? document.querySelector(selector) : ref ? document.querySelector('[data-pi-ref="' + escapeCss(ref) + '"]') : document.activeElement;
        if (!target) return { ok: false, error: "No submit target found." };
        const form = target instanceof HTMLFormElement ? target : target.closest?.("form");
        if (form) {
            if (typeof form.requestSubmit === "function") form.requestSubmit();
            else form.submit();
            return { ok: true, submitted: true, description: "submitted form" };
        }
        if (typeof target.focus === "function") target.focus();
        return { ok: true, submitted: false, description: "no form found; focused target for Enter fallback" };
    })()""" % (json.dumps(selector), json.dumps(ref))


def wait_condition_expression(selector: str, text: str, url_contains: str) -> str:
    return r"""(() => {
        const selector = %s;
        const expectedText = %s;
        const urlContains = %s;
        const visibleText = String(document.body?.innerText || document.documentElement?.innerText || "");
        return {
            url: location.href,
            selectorFound: selector ? Boolean(document.querySelector(selector)) : undefined,
            textFound: expectedText ? visibleText.includes(expectedText) : undefined,
            urlFound: urlContains ? location.href.includes(urlContains) : undefined,
        };
    })()""" % (json.dumps(selector), json.dumps(text), json.dumps(url_contains))


def wait_condition_met(result: dict[str, Any], params: dict[str, Any]) -> bool:
    if params.get("selector") and not result.get("selectorFound"):
        return False
    if params.get("text") and not result.get("textFound"):
        return False
    if params.get("urlContains") and not result.get("urlFound"):
        return False
    return True


