def action_click(
    client: CdpClient, params: dict[str, Any], timeout_ms: int
) -> dict[str, Any]:
    del timeout_ms
    selector = str(params.get("selector") or "")
    ref = str(params.get("ref") or "")
    x = params.get("x")
    y = params.get("y")
    wait_after_ms = int(params.get("waitAfterMs", 250))
    description = selector or ref or "coordinates"
    if selector or ref:
        point = evaluate_value(client, element_point_expression(selector, ref))
        if not isinstance(point, dict) or not point.get("ok"):
            raise CdpError(
                str(
                    (point or {}).get("error")
                    if isinstance(point, dict)
                    else "Could not compute click point."
                )
            )
        x = point.get("x")
        y = point.get("y")
        description = point.get("description") or description
    if x is None or y is None:
        raise CdpError("click needs selector, ref, or both x and y coordinates.")
    client.call("Input.dispatchMouseEvent", {"type": "mouseMoved", "x": x, "y": y})
    client.call(
        "Input.dispatchMouseEvent",
        {"type": "mousePressed", "x": x, "y": y, "button": "left", "clickCount": 1},
    )
    client.call(
        "Input.dispatchMouseEvent",
        {"type": "mouseReleased", "x": x, "y": y, "button": "left", "clickCount": 1},
    )
    time.sleep(wait_after_ms / 1000.0)
    return {"description": description}


