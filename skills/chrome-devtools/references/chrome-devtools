        elif arg == "--ref":
            if len(args) < 2:
                raise ToolError("--ref needs a value.")
            ref = args[1]
            del args[:2]
        elif arg == "--clear":
            clear = True
            del args[0]
        elif arg == "--submit":
            submit = True
            del args[0]
        elif arg == "--wait-after-ms":
            if len(args) < 2:
                raise ToolError("--wait-after-ms needs a value.")
            wait_after_ms = args[1]
            del args[:2]
        elif arg in {"-h", "--help"}:
            print_command_help("type")
            return
        elif arg == "--":
            del args[0]
            break
        elif arg.startswith("--"):
            raise ToolError(f"unknown type option: {arg}")
        else:
            break

    if not args:
        raise ToolError("type needs text.")
    text = " ".join(args)
    if not wait_after_ms:
        wait_after_ms = "500" if submit else "100"
    require_non_negative_int(wait_after_ms, "--wait-after-ms")

    target = target_resolve(tab_id)
    result = cdp_invoke(
        "type",
        target,
        DEFAULT_TIMEOUT_MS,
        type_params(selector, ref, text, clear, submit, wait_after_ms),
    )
    description = result.get("description") or "active element"
    print(f"Typed {len(text)} characters into {description}.")


