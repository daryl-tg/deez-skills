def format_help(template: str) -> str:
    return template.format(
        program=PROGRAM_NAME,
        default_devtools_url=DEFAULT_DEVTOOLS_URL,
        default_timeout_ms=DEFAULT_TIMEOUT_MS,
        default_max_chars=DEFAULT_MAX_CHARS,
        default_logs_duration_ms=DEFAULT_LOGS_DURATION_MS,
    )


def usage() -> None:
    sys.stdout.write(format_help(TOP_LEVEL_HELP))


def print_command_help(command_name: str) -> None:
    sys.stdout.write(format_help(COMMAND_HELP_TEMPLATES[command_name]))


def die(message: str) -> None:
    print(f"{PROGRAM_NAME}: {message}", file=sys.stderr)
    raise SystemExit(1)


def require_positive_int(value: str, label: str) -> None:
    if not re.fullmatch(r"[1-9][0-9]*", value):
        raise ToolError(f"{label} must be a positive integer.")


def require_non_negative_int(value: str, label: str) -> None:
    if not re.fullmatch(r"0|[1-9][0-9]*", value):
        raise ToolError(f"{label} must be a non-negative integer.")


def require_number(value: str, label: str) -> None:
    if not re.fullmatch(r"-?[0-9]+([.][0-9]+)?", value):
        raise ToolError(f"{label} must be a number.")


def require_choice(value: str, label: str, *choices: str) -> None:
    if value not in choices:
        raise ToolError(f"{label} must be one of: {' '.join(choices)}")


def compact_json(value: Any) -> str:
    return json.dumps(value, ensure_ascii=False, separators=(",", ":"))


def print_pretty_json(value: Any) -> None:
    print(json.dumps(value, ensure_ascii=False, indent=2))


def print_truncated(text: str, max_chars: int) -> None:
    total_chars = len(text)
    if total_chars > max_chars:
        sys.stdout.write(text[:max_chars])
        sys.stdout.write(
            f"\n\n[Output truncated to {max_chars} of {total_chars} characters.]\n"
        )
        return
    print(text)


def normalize_devtools_url(url: str) -> str:
    while url.endswith("/"):
        url = url[:-1]
    return url


def devtools_url() -> str:
    return normalize_devtools_url(
        os.environ.get("CHROME_DEVTOOLS_URL", DEFAULT_DEVTOOLS_URL)
    )


def state_dir() -> str:
    home = os.environ.get("HOME", ".")
    xdg_state_home = os.environ.get(
        "XDG_STATE_HOME", os.path.join(home, ".local", "state")
    )
    return os.environ.get(
        "CHROME_DEVTOOLS_STATE_DIR", os.path.join(xdg_state_home, "chrome-devtools")
    )


def selected_tab_file() -> str:
    return os.path.join(state_dir(), "selected-tab")


def selected_tab_read() -> str:
    try:
        with open(selected_tab_file(), encoding="utf-8") as handle:
            return handle.readline().rstrip("\n")
    except FileNotFoundError:
        return ""


def selected_tab_write(tab_id: str) -> None:
    os.makedirs(state_dir(), exist_ok=True)
    with open(selected_tab_file(), "w", encoding="utf-8") as handle:
        handle.write(tab_id + "\n")


def selected_tab_clear() -> None:
    try:
        os.unlink(selected_tab_file())
    except FileNotFoundError:
        pass


def url_encode(value: str) -> str:
    return urllib.parse.quote(value, safe="")


def http_url(path: str) -> str:
    return f"{devtools_url()}{path}"


def helper_output_error(process: subprocess.CompletedProcess[str]) -> str:
    combined = (process.stderr or process.stdout or "").strip()
    return combined or f"exit status {process.returncode}"


def http_request(method: str, path: str) -> str:
    helper = os.environ.get("CHROME_DEVTOOLS_HTTP_HELPER")
    if helper:
        try:
            process = subprocess.run(
                [helper, method, path],
                check=False,
                capture_output=True,
                text=True,
            )
        except OSError as exc:
            raise HttpRequestError(
                f"DevTools HTTP request failed ({method} {path}): {exc}"
            ) from exc
        if process.returncode != 0:
            raise HttpRequestError(
                f"DevTools HTTP request failed ({method} {path}): {helper_output_error(process)}"
            )
        return process.stdout.rstrip("\n")

    request = urllib.request.Request(http_url(path), method=method)
    try:
        with urllib.request.urlopen(
            request, timeout=DEFAULT_TIMEOUT_MS / 1000.0
        ) as response:
            return cast(bytes, response.read()).decode("utf-8")
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf-8", "replace") or str(exc)
        raise HttpRequestError(
            f"DevTools HTTP request failed ({method} {path}): {detail}"
        ) from exc
    except urllib.error.URLError as exc:
        raise HttpRequestError(
            f"DevTools HTTP request failed ({method} {path}): {exc.reason}"
        ) from exc
    except OSError as exc:
        raise HttpRequestError(
            f"DevTools HTTP request failed ({method} {path}): {exc}"
        ) from exc


def http_request_with_fallback(path: str, *methods: str) -> str:
    last_error = ""
    for method in methods:
        try:
            return http_request(method, path)
        except HttpRequestError as exc:
            last_error = str(exc)
    raise ToolError(last_error)


def json_loads(raw: str, context: str) -> Any:
    try:
        return json.loads(raw)
    except json.JSONDecodeError as exc:
        raise ToolError(f"{context} did not return valid JSON.") from exc


def dict_value(value: Any) -> dict[str, Any]:
    if isinstance(value, dict):
        return cast(dict[str, Any], value)
    return {}


def list_value(value: Any) -> list[Any]:
    if isinstance(value, list):
        return value
    return []


def dict_list_value(value: Any) -> list[dict[str, Any]]:
    if not isinstance(value, list):
        return []
    return [cast(dict[str, Any], item) for item in value if isinstance(item, dict)]


def targets_list() -> list[dict[str, Any]]:
    raw = http_request("GET", "/json/list")
    parsed = json_loads(raw, "DevTools /json/list")
    if not isinstance(parsed, list):
        raise ToolError("DevTools /json/list did not return an array.")
    return [
        target
        for target in parsed
        if isinstance(target, dict) and target.get("type") == "page"
    ]


def target_from_list(
    targets: list[dict[str, Any]], tab_id: str
) -> dict[str, Any] | None:
    for target in targets:
        if target.get("id") == tab_id:
            return target
    return None


def target_get(tab_id: str) -> dict[str, Any]:
    target = target_from_list(targets_list(), tab_id)
    if target is None:
        raise ToolError(
            f"No page tab found with id {tab_id}. Run '{PROGRAM_NAME} list-tabs' to inspect open tabs."
        )
    return target


def target_resolve(tab_id: str) -> dict[str, Any]:
    if tab_id:
        return target_get(tab_id)

    targets = targets_list()
    selected_tab_id = selected_tab_read()
    if selected_tab_id:
        target = target_from_list(targets, selected_tab_id)
        if target is not None:
            return target
        selected_tab_clear()

    count = len(targets)
    if count == 0:
        raise ToolError(
            f"No page tabs found. Run '{PROGRAM_NAME} navigate --new-tab <url>' or open a Chromium page."
        )
    if count == 1:
        return targets[0]
    raise ToolError(
        f"Multiple page tabs are open. Run '{PROGRAM_NAME} list-tabs', then '{PROGRAM_NAME} select-tab <tab-id>' or pass --tab-id."
    )


def target_id(target: dict[str, Any]) -> str:
    return str(target.get("id") or "")


def target_title(target: dict[str, Any]) -> str:
    return str(target.get("title") or "")


def target_url(target: dict[str, Any]) -> str:
    return str(target.get("url") or "")


def target_ws_url(target: dict[str, Any]) -> str:
    ws_url = str(target.get("webSocketDebuggerUrl") or "")
    if not ws_url:
        raise ToolError(
            f"Tab {target_id(target)} does not expose webSocketDebuggerUrl."
        )
    return ws_url


def tab_activate(tab_id: str) -> None:
    http_request("GET", f"/json/activate/{url_encode(tab_id)}")


def tab_create(initial_url: str) -> dict[str, Any]:
    raw = http_request_with_fallback(
        f"/json/new?{url_encode(initial_url)}", "PUT", "GET"
    )
    parsed = json_loads(raw, "DevTools /json/new")
    if isinstance(parsed, dict) and parsed.get("type") == "page":
        return parsed

    targets = targets_list()
    for target in targets:
        if target.get("url") == initial_url:
            return target
    if targets:
        return targets[0]
    raise ToolError("Chromium did not return a new page target.")


def format_tabs(targets: list[dict[str, Any]]) -> str:
    selected_tab_id = selected_tab_read()
    if not targets:
        return "No page tabs found. Start Chromium with --remote-debugging-port=9222 and open a page."

    formatted = []
    for index, target in enumerate(targets, start=1):
        marker = "*" if target.get("id") == selected_tab_id else " "
        title = str(target.get("title") or "") or "(untitled)"
        url = str(target.get("url") or "") or "about:blank"
        formatted.append(
            f"{marker} [{index}] id={target.get('id')}\n    title: {title}\n    url: {url}"
        )
    return "\n".join(formatted)


class CdpClient:
    def __init__(self, ws_url: str, timeout_ms: int):
        self.ws_url = ws_url
        self.timeout_s = max(timeout_ms / 1000.0, 0.001)
        self.next_id = 1
        self.events: list[dict[str, Any]] = []
        self.sock = self._connect(ws_url)

    def _connect(self, ws_url: str) -> socket.socket:
        parsed = urllib.parse.urlparse(ws_url)
        if parsed.scheme not in {"ws", "wss"}:
            raise CdpError(f"Unsupported WebSocket URL scheme: {parsed.scheme}")
        host = parsed.hostname
        if not host:
            raise CdpError("WebSocket URL is missing a host.")
        port = parsed.port or (443 if parsed.scheme == "wss" else 80)
        path = parsed.path or "/"
        if parsed.query:
            path += "?" + parsed.query

        raw_sock = socket.create_connection((host, port), timeout=self.timeout_s)
        if parsed.scheme == "wss":
            raw_sock = ssl.create_default_context().wrap_socket(
                raw_sock, server_hostname=host
            )

        key = base64.b64encode(os.urandom(16)).decode("ascii")
        host_header = f"{host}:{port}"
        request = (
            f"GET {path} HTTP/1.1\r\n"
            f"Host: {host_header}\r\n"
            "Upgrade: websocket\r\n"
            "Connection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {key}\r\n"
            "Sec-WebSocket-Version: 13\r\n"
            "\r\n"
        )
        raw_sock.sendall(request.encode("ascii"))
        response = b""
        raw_sock.settimeout(self.timeout_s)
        while b"\r\n\r\n" not in response:
            chunk = raw_sock.recv(4096)
            if not chunk:
                raise CdpError("WebSocket handshake ended early.")
            response += chunk
            if len(response) > 65536:
                raise CdpError("WebSocket handshake response was too large.")

        header_text = response.split(b"\r\n\r\n", 1)[0].decode("iso-8859-1", "replace")
        status_line = header_text.split("\r\n", 1)[0]
        if " 101 " not in f" {status_line} ":
            raise CdpError(f"WebSocket handshake failed: {status_line}")
        expected_accept = base64.b64encode(
            hashlib.sha1(
                (key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode("ascii")
            ).digest()
        ).decode("ascii")
        headers = {}
        for line in header_text.split("\r\n")[1:]:
            if ":" in line:
                name, value = line.split(":", 1)
                headers[name.strip().lower()] = value.strip()
        if headers.get("sec-websocket-accept") != expected_accept:
            raise CdpError(
                "WebSocket handshake returned an invalid Sec-WebSocket-Accept header."
            )
        return raw_sock

    def close(self) -> None:
        try:
            self._send_frame(b"", opcode=0x8)
        except Exception:
            pass
        try:
            self.sock.close()
        except Exception:
            pass

    def _recv_exact(self, size: int) -> bytes:
        chunks = []
        remaining = size
        while remaining > 0:
            chunk = self.sock.recv(remaining)
            if not chunk:
                raise CdpError("Chrome DevTools WebSocket closed.")
            chunks.append(chunk)
            remaining -= len(chunk)
        return b"".join(chunks)

    def _send_frame(self, payload: bytes | str, opcode: int = 0x1) -> None:
        if isinstance(payload, str):
            payload = payload.encode("utf-8")
        length = len(payload)
        if length < 126:
            header = struct.pack("!BB", 0x80 | opcode, 0x80 | length)
        elif length <= 0xFFFF:
            header = struct.pack("!BBH", 0x80 | opcode, 0x80 | 126, length)
        else:
            header = struct.pack("!BBQ", 0x80 | opcode, 0x80 | 127, length)
        mask = os.urandom(4)
        masked = bytes(byte ^ mask[index % 4] for index, byte in enumerate(payload))
        self.sock.sendall(header + mask + masked)

    def _recv_frame(self, timeout_s: float | None = None) -> str:
        self.sock.settimeout(timeout_s if timeout_s is not None else self.timeout_s)
        while True:
            first = self._recv_exact(2)
            byte1, byte2 = first[0], first[1]
            fin = bool(byte1 & 0x80)
            opcode = byte1 & 0x0F
            masked = bool(byte2 & 0x80)
            length = byte2 & 0x7F
            if length == 126:
                length = struct.unpack("!H", self._recv_exact(2))[0]
            elif length == 127:
                length = struct.unpack("!Q", self._recv_exact(8))[0]
            mask = self._recv_exact(4) if masked else b""
            payload = self._recv_exact(length) if length else b""
            if masked:
                payload = bytes(
                    byte ^ mask[index % 4] for index, byte in enumerate(payload)
                )
            if opcode == 0x8:
                raise CdpError("Chrome DevTools WebSocket closed.")
            if opcode == 0x9:
                self._send_frame(payload, opcode=0xA)
                continue
            if opcode == 0xA:
                continue
            if opcode != 0x1:
                continue
            if not fin:
                raise CdpError("Fragmented WebSocket messages are not supported.")
            return payload.decode("utf-8")

    def _recv_message(self, timeout_s: float | None = None) -> dict[str, Any]:
        text = self._recv_frame(timeout_s)
        try:
            parsed = json.loads(text)
        except json.JSONDecodeError:
            return {}
        return parsed if isinstance(parsed, dict) else {}

    def call(self, method: str, params: dict[str, Any] | None = None) -> dict[str, Any]:
        request_id = self.next_id
        self.next_id += 1
        self._send_frame(
            compact_json({"id": request_id, "method": method, "params": params or {}})
        )
        deadline = time.monotonic() + self.timeout_s
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise CdpError(
                    f"Timed out waiting for {method} after {int(self.timeout_s * 1000)}ms."
                )
            try:
                message = self._recv_message(remaining)
            except TimeoutError as exc:
                raise CdpError(
                    f"Timed out waiting for {method} after {int(self.timeout_s * 1000)}ms."
                ) from exc
            if message.get("id") == request_id:
                if "error" in message:
                    error = message.get("error") or {}
                    message_text = (
                        error.get("message", "Chrome DevTools protocol error")
                        if isinstance(error, dict)
                        else "Chrome DevTools protocol error"
                    )
                    code = error.get("code") if isinstance(error, dict) else None
                    if code is not None:
                        message_text = f"{message_text} (code {code})"
                    raise CdpError(message_text)
                result = message.get("result") or {}
                return result if isinstance(result, dict) else {}
            if "method" in message:
                self.events.append(message)

    def wait_for_event(
        self,
        method: str,
        timeout_s: float,
        tracker: Callable[[dict[str, Any]], None] | None = None,
    ) -> dict[str, Any]:
        deadline = time.monotonic() + timeout_s
        while True:
            for index, event in enumerate(list(self.events)):
                if tracker:
                    tracker(event)
                if event.get("method") == method:
                    self.events.pop(index)
                    params = event.get("params") or {}
                    return params if isinstance(params, dict) else {}
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise CdpError(
                    f"Timed out waiting for {method} after {int(timeout_s * 1000)}ms."
                )
            try:
                message = self._recv_message(remaining)
            except TimeoutError as exc:
                raise CdpError(
                    f"Timed out waiting for {method} after {int(timeout_s * 1000)}ms."
                ) from exc
            if "method" in message:
                self.events.append(message)


def short(value: Any, max_len: int = 80) -> str:
    if not value:
        return ""
    normalized = " ".join(str(value).split())
    if len(normalized) > max_len:
        return normalized[: max_len - 1] + "…"
    return normalized


def normalize_text(value: Any) -> str:
    lines = []
    for line in str(value or "").replace("\r\n", "\n").replace("\r", "\n").split("\n"):
        normalized = " ".join(line.replace("\t", " ").split())
        if normalized:
            lines.append(normalized)
    text = "\n".join(lines).strip()
    while "\n\n\n" in text:
        text = text.replace("\n\n\n", "\n\n")
    return text


def format_runtime_exception(details: dict[str, Any]) -> str:
    exception = dict_value(details.get("exception"))
    message = (
        exception.get("description")
        or exception.get("unserializableValue")
        or details.get("text")
        or "JavaScript exception"
    )
    if "lineNumber" in details:
        line = int(details.get("lineNumber", 0)) + 1
        column = int(details.get("columnNumber", 0)) + 1
        message += f" at {line}:{column}"
    return str(message)


def format_remote_object(remote: dict[str, Any]) -> str:
    if not remote:
        return "undefined"
    if "value" in remote:
        value = remote.get("value")
        if isinstance(value, str):
            return value
        return json.dumps(value, indent=2, ensure_ascii=False)
    if remote.get("unserializableValue"):
        return str(remote["unserializableValue"])
    if remote.get("description"):
        return str(remote["description"])
    return str(remote.get("type") or "undefined")


def runtime_evaluate(
    client: CdpClient,
    expression: str,
    await_promise: bool = True,
    return_by_value: bool = True,
) -> dict[str, Any]:
    raw = client.call(
        "Runtime.evaluate",
        {
            "expression": expression,
            "awaitPromise": await_promise,
            "returnByValue": return_by_value,
            "userGesture": True,
        },
    )
    exception_details = raw.get("exceptionDetails")
    if isinstance(exception_details, dict):
        raise CdpError(format_runtime_exception(exception_details))
    result = raw.get("result") or {}
    return result if isinstance(result, dict) else {}


def evaluate_value(client: CdpClient, expression: str) -> Any:
    return runtime_evaluate(
        client, expression, await_promise=True, return_by_value=True
    ).get("value")


