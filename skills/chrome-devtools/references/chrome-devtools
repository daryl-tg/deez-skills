def main(argv: list[str]) -> int:
    command_name = argv[0] if argv else ""
    if command_name in {"", "-h", "--help"}:
        usage()
        return 0
    if command_name == "help":
        if len(argv) == 1:
            usage()
            return 0
        if len(argv) != 2:
            raise ToolError("help accepts at most one command name.")
        help_name = argv[1]
        if help_name not in COMMAND_HELP_TEMPLATES:
            raise ToolError(f"unknown command: {help_name}")
        print_command_help(help_name)
        return 0
    if command_name in {"--version", "version"}:
        print(f"{PROGRAM_NAME} {VERSION}")
        return 0

    command = COMMANDS.get(command_name)
    if command is None:
        raise ToolError(f"unknown command: {command_name}")
    command(list(argv[1:]))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except BrokenPipeError:
        raise SystemExit(1) from None
    except ToolError as exc:
        die(str(exc))
