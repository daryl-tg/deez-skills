    "read-page": action_read_page,
    "logs": action_logs,
}


def run_cdp_action(
    action: str, ws_url: str, timeout_ms: int, params: dict[str, Any]
) -> dict[str, Any]:
    action_func = CDP_ACTIONS.get(action)
    if action_func is None:
        raise CdpError(f"Unknown CDP action: {action}")
    client = CdpClient(ws_url, timeout_ms)
    try:
        return action_func(client, params, timeout_ms)
    finally:
        client.close()


def cdp_invoke(
    action: str, target: dict[str, Any], timeout_ms: int, params: dict[str, Any]
) -> dict[str, Any]:
    ws_url = target_ws_url(target)
    params_json = compact_json(params)
    helper = os.environ.get("CHROME_DEVTOOLS_CDP_HELPER")
    if helper:
        try:
            process = subprocess.run(
                [helper, action, ws_url, str(timeout_ms)],
                input=params_json + "\n",
                check=False,
                capture_output=True,
                text=True,
            )
        except OSError as exc:
            raise ToolError(f"CDP action '{action}' failed: {exc}") from exc
        if process.returncode != 0:
            raise ToolError(
                f"CDP action '{action}' failed: {helper_output_error(process)}"
            )
        try:
            parsed = json.loads(process.stdout)
        except json.JSONDecodeError as exc:
            raise ToolError(f"CDP action '{action}' returned invalid JSON.") from exc
        return parsed if isinstance(parsed, dict) else {}

    try:
        return run_cdp_action(action, ws_url, timeout_ms, params)
    except (CdpError, OSError, ssl.SSLError, TimeoutError) as exc:
        raise ToolError(f"CDP action '{action}' failed: {exc}") from exc


