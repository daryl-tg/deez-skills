def action_wait(
    client: CdpClient, params: dict[str, Any], timeout_ms: int
) -> dict[str, Any]:
    del timeout_ms
    selector = str(params.get("selector") or "")
    text = str(params.get("text") or "")
    url_contains = str(params.get("urlContains") or "")
    timeout_ms = int(
        params.get(
            "timeoutMs",
            DEFAULT_TIMEOUT_MS if (selector or text or url_contains) else 1000,
        )
    )
    started = time.monotonic()
    if not selector and not text and not url_contains:
        time.sleep(timeout_ms / 1000.0)
        return {"durationMs": timeout_ms, "url": ""}
    deadline = started + timeout_ms / 1000.0
    expression = wait_condition_expression(selector, text, url_contains)
    final = {"url": ""}
    while time.monotonic() < deadline:
        result = evaluate_value(client, expression)
        if isinstance(result, dict):
            final = result
            if wait_condition_met(result, params):
                return {
                    "durationMs": int((time.monotonic() - started) * 1000),
                    "url": result.get("url", ""),
                }
        time.sleep(DEFAULT_WAIT_INTERVAL_MS / 1000.0)
    raise CdpError(
        f"Timed out after {timeout_ms}ms waiting for requested Chrome page condition. Last URL: {final.get('url', '')}"
    )


