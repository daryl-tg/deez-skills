<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dboon.verify-maintenance</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-l</string>
    <string>HOME_DIR/github/deez-skills/skills/maintain-verification-skill/scripts/nightly.zsh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>17</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>HOME_DIR/Library/Logs/verify-maintenance/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>HOME_DIR/Library/Logs/verify-maintenance/launchd.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
